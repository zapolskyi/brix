# Єдине форматування для редакторів. WordPress Coding Standards —
# табуляція в PHP і JS; SCSS, JSON і Markdown лишаємо на пробілах.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{scss,css,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[composer.json]
indent_style = space
indent_size = 4
