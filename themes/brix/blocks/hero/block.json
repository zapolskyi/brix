{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "brix/hero",
	"title": "Герой",
	"category": "brix",
	"icon": "cover-image",
	"description": "Великий заголовок, текст і дві кнопки. Пачка праворуч — лот тижня з каталогу.",
	"textdomain": "brix",
	"attributes": {
		"label": { "type": "string", "default": "" },
		"heading": { "type": "string", "default": "Зібрано при 22°Bx" },
		"accent": { "type": "string", "default": "22°Bx" },
		"text": { "type": "string", "default": "" },
		"primaryLabel": { "type": "string", "default": "Обрати каву" },
		"primaryUrl": { "type": "string", "default": "" },
		"secondaryLabel": { "type": "string", "default": "" },
		"secondaryUrl": { "type": "string", "default": "" },
		"showLot": { "type": "boolean", "default": true }
	},
	"supports": { "html": false, "align": ["full"] },
	"render": "file:./render.php"
}
