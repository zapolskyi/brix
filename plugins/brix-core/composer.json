{
    "name": "nzapolskyi/brix-core",
    "description": "Бізнес-логіка магазину BRIX 22°: паспорт лоту, фільтри каталогу, квіз, Нова Пошта, оптовий кабінет.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Nazar Zapolskyi",
            "email": "nazar.zapolski@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Brix\\Core\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    }
}
