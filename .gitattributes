# Файли, які не потрапляють в архів для хостингу (git archive).
# На сервері вони не потрібні: це джерела збірки, документація й dev-інструменти.

/.gitattributes                  export-ignore
/.gitignore                      export-ignore
/README.md                       export-ignore

# Тема й плагін архівуються окремо, кожен своїм піддеревом
# (git archive HEAD:themes/brix), тож їхні export-ignore живуть
# у власних .gitattributes всередині — правила звідси на піддерево не діють.

# Нормалізація перекладів рядків
*.php  text eol=lf
*.scss text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.json text eol=lf

# Бінарні файли не діфимо
*.woff2 binary
*.png   binary
*.jpg   binary
*.webp  binary
